# PostgreSQL. Run npm run db:migrate before starting an existing deployment.
DATABASE_URL=postgresql://notes_user:password@localhost:5432/notes

# Canonical public origin, without a trailing slash. Both must match your actual deployment.
NEXT_PUBLIC_SITE_URL=https://dcepedag.com
APP_ORIGIN=https://dcepedag.com

# Replit App Storage: /bucket-name/private-prefix. Credentials come from Replit's sidecar.
PRIVATE_OBJECT_DIR=/your-bucket/your-private-prefix

# Optional messages app reverse proxy.
# NEXT_PUBLIC_MESSAGES_URL=https://your-messages-app.example

# REVALIDATE_TOKEN and NEXT_PUBLIC_REVALIDATE_TOKEN are no longer used.
